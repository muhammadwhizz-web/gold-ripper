# GOLD RIPPER :: environment template
# copy to .env and fill in what you need. EVERY value has a safe default;
# only RIPPER_MODE + the Bitget keys matter for live trading.

# ── mode ──────────────────────────────────────────────────────────────
# PAPER (default, safe) | LIVE (real Bitget orders - keys required)
RIPPER_MODE=PAPER

# ── Bitget (LIVE) ─────────────────────────────────────────────────────
BITGET_KEY=
BITGET_SECRET=
BITGET_PASSPHRASE=
# symbol auto-probes XAU/USDT:USDT -> XAUT/USDT:USDT -> PAXG/USDT:USDT
#BITGET_SYMBOL=XAU/USDT:USDT
BITGET_LEVERAGE=3
# bump if the venue complains about clock skew (ms)
BITGET_RECV_WINDOW=20000
# venue plan armor: keep full-position TP/SL plan orders attached and
# re-place a missing leg (crash protection). 1=on (recommended)
BITGET_PLANS_ARMOR=1
BITGET_PLANS_CHECK_S=60

# ── THE RAILS (your mission) ──────────────────────────────────────────
BLOCK_TARGET_USD=20
BLOCK_MAX_LOSS_USD=3
DAY_TARGET_USD=120
DAY_MAX_LOSS_USD=5
MAX_ATTEMPTS_PER_BLOCK=3
RISK_USD_PER_TRADE=1
MAX_RISK_USD_PER_TRADE=1.5
CONSEC_LOSS_PAUSE_AFTER=2
CONSEC_LOSS_PAUSE_MIN=45
STARTING_BALANCE=1000

# ── protections (freqtrade merge) ─────────────────────────────────────
# H1-bar based: cooldown after every close, stoploss guard, drawdown guard
PROT_ENABLED=1
PROT_COOLDOWN_BARS=2
PROT_SL_WINDOW_BARS=24
PROT_SL_MAX=2
PROT_SL_PAUSE_BARS=4
PROT_DD_WINDOW_BARS=24
PROT_DD_MAX_USD=6

# ── daily assurance (zero-trade-day killer, v2.2.0) ──────────────────
# From ASSURE_HOUR_UTC, if the day has ZERO fills, entry gates relax on
# a 3-step ladder so at least one risk-sized attempt happens every day.
# Safety rails (loss caps, black swan, news, cost floor, D1 bias) are
# NEVER relaxed. ASSURE_DAILY=0 disables (not recommended).
ASSURE_DAILY=1
ASSURE_HOUR_UTC=20
ASSURE_STEPS=3
ASSURE_ESCALATE_MIN=45

# ── fast lane (ms-class indicators) ──────────────────────────────────
RIPPER_FAST_LANE=1
RIPPER_FAST_WRITE_S=15

# ── loop / feed ───────────────────────────────────────────────────────
POLL_SECONDS=60
RIPPER_FEED=auto          # auto | venue | yahoo | csv
RIPPER_FEED_TIMEOUT_S=20
RIPPER_FEED_CACHE_S=45

# ── strategy overrides (trained params in data/calibration.json win) ──
#MIN_ATR_USD=3
#BIAS_FILTER=1
#MAKER_ENTRY=1
#MAKER_WAIT_BARS=3

# ── news guard ────────────────────────────────────────────────────────
NEWS_GUARD=1
NEWS_BLACKOUT_MIN=10

# ── Telegram (optional) ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── self-check / reconciliation ───────────────────────────────────────
RIPPER_SELF_CHECK=1
RIPPER_SELF_CHECK_INTERVAL_S=900
RIPPER_DRIFT_COOLDOWN_MIN=360
RIPPER_RECONCILE_MIN=30
RIPPER_RECONCILE_COOLDOWN_MIN=360

# ── multi-instance tag (optional) ─────────────────────────────────────
# RIPPER_SYMBOL_TAG=XAG   (then BITGET_SYMBOL=XAG/USDT:USDT)
